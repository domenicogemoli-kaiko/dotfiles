[help]
  # Do not automatically correct and execute mistyped commands
    autocorrect = 0
[merge]
  # Include summaries of merged commits in newly created merge commit messages
    log = true
[core]
    editor = code --wait --reuse-window
    excludesfile = ~/.gitignore_global
    pager = diff-so-fancy | less --tabs=4 -RF
[user]
    email = domenicogemoli@gmail.com
    name = Domenico Gemoli
[merge]
    tool = vscode
[mergetool "vscode"]
    cmd = code --wait --reuse-window $MERGED
[diff]
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --reuse-window --diff $LOCAL $REMOTE
[sequence]
    editor = code --wait --reuse-window
[pull]
    ff = only
[init]
	defaultBranch = main
[filter "lfs"]
	smudge = /opt/homebrew/bin/git-lfs smudge -- %f
	process = /opt/homebrew/bin/git-lfs filter-process
	required = true
	clean = /opt/homebrew/bin/git-lfs clean -- %f

# Use the Kaiko identity in Kaiko repositories. hasconfig matches on the
# configured remote, so it follows a clone wherever it lands instead of
# depending on where it sits on disk — ~/git mixes work clones with personal
# and third-party ones. Both URL spellings are listed because these are cloned
# over https and ssh interchangeably.
#
# Caveat: a remote has to exist for this to match. `git clone` configures one
# before you can commit, but `git init` does not — a repository created locally
# and pushed later takes the default identity above until its remote is added.
[includeIf "hasconfig:remote.*.url:https://github.com/kaiko-ai/**"]
    path = ~/.gitconfig-kaiko
[includeIf "hasconfig:remote.*.url:git@github.com:kaiko-ai/**"]
    path = ~/.gitconfig-kaiko
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/kaiko-ai/**"]
    path = ~/.gitconfig-kaiko
